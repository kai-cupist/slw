# ── 의존성 ──
node_modules/

# ── 환경변수 ──
.env
.env.*
!.env.example

# ── 빌드 결과물 ──
dist/
build/
.next/
web-build/

# ── Expo / React Native ──
.expo/
ios/
android/
*.jsbundle
*.hbc
expo-env.d.ts
mobile/.gitignore

# ── 테스트 ──
coverage/

# ── 로그 ──
*.log
npm-debug.log*

# ── IDE / 에디터 ──
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# ── OS ──
.DS_Store
Thumbs.db

# ── 캐시 / 임시 ──
.cache/
tmp/

# ── Agent tooling ──
.bg-shell/
.mcp.json
.claude/plans

# ── GSD runtime ──
# DB / 락
.gsd/gsd.db
.gsd/gsd.db-wal
.gsd/gsd.db-shm
.gsd/*.lock
# 시스템 생성 파일 — 글로브로 묶어 신규 파일도 자동 커버
.gsd/*.json
.gsd/*.jsonl
# 파생 캐시
.gsd/STATE.md
.gsd/CODEBASE.md
.gsd/last-snapshot.md
# 시스템 관리 디렉토리
.gsd/runtime/
.gsd/activity/
.gsd/journal/
.gsd/forensics/
.gsd/worktrees/
.gsd/parallel/
.gsd/reports/
.gsd/browser-state/
.gsd/browser-baselines/
# 임시 재개 파일
.gsd/milestones/**/continue.md
.gsd/milestones/**/*-CONTINUE.md

# ── GSD baseline (auto-generated) ──
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
